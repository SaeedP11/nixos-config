// Style: floating-bubble
// Description: Soft fluid curves and generous volumetric elevation inspired by visionOS and modern liquid design.

// SECTION: layout
gaps 20

focus-ring {
    width 2
    active-gradient from="@wallust-accent@" to="@wallust-accent-secondary@" angle=135 relative-to="workspace-view"
    inactive-color "@wallust-inactive@"
}

border {
    off
}

shadow {
    on
    softness 58
    spread 9
    offset x=0 y=12
    color "#0000005a"
}

// SECTION: rules
window-rule {
    geometry-corner-radius 24
    clip-to-geometry true
    opacity 0.91
}

window-rule {
    match is-focused=false
    opacity 0.81
}

window-rule {
    match app-id=r#"^mpv$"#
    match app-id=r#"^org\.gnome\.Papers$"#
    match app-id=r#"^org\.kde\.okular$"#
    match app-id=r#"^org\.gnome\.Snapshot$"#
    opacity 1.0
}
