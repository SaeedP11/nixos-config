# Generated by 'nixos-generate-config --show-hardware-config' on this machine
# (ASUS H110M-C, i5-6400, GeForce GT 730). Keep this a pure hardware scan so
# it stays regenerable; policy belongs in ./default.nix.
#
# The filesystems are mounted by label rather than by the UUIDs the scan
# would emit, matching ../shared/hardware-configuration.nix.
{ lib, modulesPath, ... }:

{
  imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];

  boot.initrd.availableKernelModules = [ "xhci_pci" "ahci" "usbhid" "sd_mod" "sr_mod" ];

  fileSystems."/" = {
    device = "/dev/disk/by-label/NIXROOT";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-label/NIXBOOT";
    fsType = "vfat";
  };

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
}
